generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String?
  role                UserRole             @default(ADMIN)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  eventUsers          EventUser[]
  events              Event[]
  importBatches       ImportBatch[]
  registrations       Registration[]
  merchCampaigns      MerchCampaign[]
  kidRunCampaigns     KidRunCampaign[]
  kidRunCampaignUsers KidRunCampaignUser[]
  racePacksCollected  Registration[]       @relation("RacePackCollector")

  @@map("users")
}

model Event {
  id                       String      @id @default(cuid())
  name                     String
  slug                     String      @unique
  description              String?
  date                     DateTime
  location                 String
  address                  String?
  city                     String?
  status                   EventStatus @default(DRAFT)
  isPublished              Boolean     @default(false)
  allowRegistration        Boolean     @default(false)
  racePackLocation         String?
  racePackTime             String?
  racePackSchedule         String?
  raceDaySchedule          String?
  parkingInfo              String?
  checkinProcedure         String?
  hotline                  String?
  emailSupport             String?
  facebookUrl              String?
  websiteUrl               String?
  logoUrl                  String?
  bannerUrl                String?
  coverImageUrl            String?
  hasShirt                 Boolean     @default(false)
  requiresShirtPurchase    Boolean     @default(false) @map("requires_shirt_purchase")
  allowStandaloneShirtSale Boolean     @default(true) @map("allow_standalone_shirt_sale")
  requireOnlinePayment     Boolean     @default(true)
  sendBibImmediately       Boolean     @default(true)
  registrationServiceOnly  Boolean     @default(false) @map("registration_service_only")
  enableOptionalFinisherDonation Boolean @default(false) @map("enable_optional_finisher_donation")
  minFinisherDonation      Int         @default(0) @map("min_finisher_donation")
  bankName                 String?     @db.Text
  bankAccount              String?     @db.Text
  bankHolder               String?     @db.Text
  bankCode                 String?     @db.Text

  // ✅ NEW: Form field visibility configuration
  showIdCard            Boolean @default(true) @map("show_id_card")
  showAddress           Boolean @default(true) @map("show_address")
  showCity              Boolean @default(true) @map("show_city")
  showBloodType         Boolean @default(false) @map("show_blood_type")
  showEmergencyContact  Boolean @default(true) @map("show_emergency_contact")
  showHealthDeclaration Boolean @default(true) @map("show_health_declaration")
  showBibName           Boolean @default(true) @map("show_bib_name")
  requireWaiver         Boolean @default(false) @map("require_waiver")
  waiverTitle           String? @map("waiver_title")
  waiverContent         String? @map("waiver_content") @db.Text
  waiverVersion         String? @map("waiver_version")

  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  distances     Distance[]
  emailConfig   EmailConfig?
  eventImages   EventImage[]
  shirts        EventShirt[]
  assignedUsers EventUser[]
  createdBy     User           @relation(fields: [createdById], references: [id])
  importBatches ImportBatch[]
  registrations Registration[]
  shirtOrders   ShirtOrder[]

  @@map("events")
}

model EventImage {
  id                 String         @id @default(cuid())
  eventId            String
  imageUrl           String
  cloudinaryPublicId String?
  imageType          EventImageType
  title              String?
  description        String?
  sortOrder          Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  event              Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, imageType])
  @@map("event_images")
}

model Distance {
  id                       String         @id @default(cuid())
  eventId                  String
  name                     String
  price                    Int
  bibPrefix                String
  maxParticipants          Int?
  currentParticipants      Int            @default(0)
  isAvailable              Boolean        @default(true)
  sortOrder                Int            @default(0)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  hasGoals                 Boolean        @default(false)
  requiresFinisherShirt    Boolean        @default(false) @map("requires_finisher_shirt")
  cloneRaceShirtToFinisher Boolean        @default(false) @map("clone_race_shirt_to_finisher")
  distanceGoals            DistanceGoal[]
  event                    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations            Registration[]

  @@unique([eventId, name])
  @@map("distances")
}

model DistanceGoal {
  id                  String         @id @default(cuid())
  distanceId          String
  name                String
  description         String?
  targetTime          Int?
  bibPrefix           String
  maxParticipants     Int?
  currentParticipants Int            @default(0)
  priceAdjustment     Int            @default(0)
  isAvailable         Boolean        @default(true)
  sortOrder           Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  distance            Distance       @relation(fields: [distanceId], references: [id], onDelete: Cascade)
  registrations       Registration[]

  @@unique([distanceId, name])
  @@index([distanceId, isAvailable])
  @@map("distance_goals")
}

model EventShirt {
  id                 String           @id @default(cuid())
  eventId            String
  category           ShirtCategory
  type               ShirtType
  size               ShirtSize
  price              Int
  stockQuantity      Int
  soldQuantity       Int              @default(0)
  isAvailable        Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  previewImageUrl    String?
  cloudinaryPublicId String?
  standalonePrice    Int?
  event              Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations      Registration[]
  shirtOrders        ShirtOrderItem[]

  @@unique([eventId, category, type, size])
  @@index([eventId, isAvailable])
  @@map("event_shirts")
}

model WebhookLog {
  id            String    @id @default(cuid())
  provider      String
  event         String
  payload       String    @db.Text
  status        String
  errorMessage  String?   @db.Text
  eventId       String?   @map("event_id")
  retryable     Boolean   @default(false)
  retryCount    Int       @default(0) @map("retry_count")
  maxRetries    Int       @default(5) @map("max_retries")
  nextRetryAt   DateTime? @map("next_retry_at")
  lastRetryAt   DateTime? @map("last_retry_at")
  retrySourceId String?   @map("retry_source_id")
  createdAt     DateTime  @default(now())

  @@index([provider, createdAt])
  @@index([status])
  @@index([eventId])
  @@index([retryable, nextRetryAt])
  @@index([retrySourceId])
  @@map("webhook_logs")
}

model Registration {
  id                    String              @id @default(cuid())
  eventId               String
  distanceId            String
  shirtId               String?
  fullName              String
  bibName               String?
  email                 String
  phone                 String
  registrationNumber    Int                 @unique @default(autoincrement()) @map("registration_number")
  dob                   DateTime
  gender                Gender
  idCard                String?
  address               String?
  city                  String?
  emergencyContactName  String?
  emergencyContactPhone String?
  healthDeclaration     Boolean             @default(false)
  waiverAccepted        Boolean             @default(false) @map("waiver_accepted")
  waiverAcceptedAt      DateTime?           @map("waiver_accepted_at")
  waiverVersion         String?             @map("waiver_version")
  bloodType             String?
  shirtCategory         ShirtCategory?
  shirtType             ShirtType?
  shirtSize             ShirtSize?
  finisherShirtCategory ShirtCategory?      @map("finisher_shirt_category")
  finisherShirtType     ShirtType?          @map("finisher_shirt_type")
  finisherShirtSize     ShirtSize?          @map("finisher_shirt_size")
  raceFee               Int
  shirtFee              Int                 @default(0)
  totalAmount           Int
  paymentStatus         PaymentStatus       @default(PENDING)
  bibNumber             String?
  shortCode             String?             @unique @map("short_code") // DH + registration id - nội dung CK
  qrPaymentUrl          String?
  qrCheckinUrl          String?
  confirmationToken     String?             @unique
  utmSource             String?
  notes                 String?
  registrationDate      DateTime            @default(now())
  paymentDate           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  userId                String?
  registrationSource    RegistrationSource? @default(ONLINE)
  importBatchId         String?
  distanceGoalId        String?
  racePackCollected     Boolean             @default(false)
  racePackCollectedAt   DateTime?
  racePackCollectedBy   String?
  racePackPhoto         String?
  racePackNotes         String?
  emailLogs             EmailLog[]
  payments              Payment[]
  distanceGoal          DistanceGoal?       @relation(fields: [distanceGoalId], references: [id])
  distance              Distance            @relation(fields: [distanceId], references: [id])
  event                 Event               @relation(fields: [eventId], references: [id])
  importBatch           ImportBatch?        @relation(fields: [importBatchId], references: [id])
  shirt                 EventShirt?         @relation(fields: [shirtId], references: [id])
  user                  User?               @relation(fields: [userId], references: [id])
  shirtOrders           ShirtOrder[]
  collectedBy           User?               @relation("RacePackCollector", fields: [racePackCollectedBy], references: [id])

  @@unique([eventId, bibNumber])
  @@index([importBatchId])
  @@index([eventId, paymentStatus])
  @@index([distanceId])
  @@index([distanceGoalId])
  @@index([email])
  @@index([importBatchId, paymentStatus])
  @@map("registrations")
}

model Payment {
  id             String         @id @default(cuid())
  registrationId String?
  shirtOrderId   String?
  merchOrderId   String?
  purpose        PaymentPurpose @default(REGISTRATION)
  transactionId  String?        @unique
  amount         Int
  status         PaymentStatus  @default(PENDING)
  paymentMethod  String?
  webhookData    Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  registration   Registration?  @relation(fields: [registrationId], references: [id])
  shirtOrder     ShirtOrder?    @relation(fields: [shirtOrderId], references: [id])
  merchOrder     MerchOrder?    @relation(fields: [merchOrderId], references: [id])

  @@index([registrationId])
  @@index([shirtOrderId])
  @@index([merchOrderId])
  @@index([purpose])
  @@map("payments")
}

model EmailConfig {
  id                          String   @id @default(cuid())
  eventId                     String   @unique
  fromName                    String
  fromEmail                   String
  replyTo                     String?
  useGmailFallback            Boolean  @default(false)
  gmailUser                   String?
  gmailAppPassword            String?
  subjectRegistrationPending  String   @default("Xác nhận đăng ký - {{eventName}}")
  subjectPaymentConfirmed     String   @default("Thanh toán thành công - Số BIB {{bibNumber}}")
  subjectPaymentReceivedNoBib String   @default("Đã nhận thanh toán - {{eventName}}")
  subjectBibAnnouncement      String   @default("Thông báo số BIB - {{eventName}}")
  subjectRacePackInfo         String   @default("Thông tin quan trọng - {{eventName}}")
  subjectReminder             String   @default("Nhắc nhở - {{eventName}}")
  bodyRegistrationPending     String
  bodyPaymentConfirmed        String
  bodyPaymentReceivedNoBib    String
  bodyBibAnnouncement         String
  bodyRacePackInfo            String
  bodyReminder                String
  attachQrPayment             Boolean  @default(true)
  attachQrCheckin             Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  subjectShirtOrder           String?  @default("Xác nhận đơn hàng áo - {{eventName}}")
  bodyShirtOrder              String?  @default("Đơn hàng áo của bạn đã được xác nhận")
  event                       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("email_configs")
}

model EmailLog {
  id             String       @id @default(cuid())
  registrationId String
  emailType      EmailType
  subject        String?
  sentAt         DateTime     @default(now())
  status         EmailStatus  @default(SENT)
  errorMessage   String?
  resendCount    Int          @default(0)
  bibNumber      String?
  emailProvider  String?
  recipientEmail String
  registration   Registration @relation(fields: [registrationId], references: [id])

  @@index([registrationId, emailType])
  @@index([bibNumber])
  @@index([recipientEmail])
  @@index([emailProvider, status])
  @@map("email_logs")
}

model ImportBatch {
  id            String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  eventId       String
  fileName      String
  uploadedBy    String
  totalRows     Int
  successCount  Int          @default(0)
  failedCount   Int          @default(0)
  status        ImportStatus @default(PROCESSING)
  errorLog      Json?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
  contactEmail  String?
  bibRangeStart String?
  bibRangeEnd   String?
  totalShirts   Int          @default(0)
  qrBatchUrl    String?

  event          Event          @relation(fields: [eventId], references: [id])
  uploadedByUser User           @relation(fields: [uploadedBy], references: [id])
  registrations  Registration[]

  @@index([eventId, status])
  @@map("import_batches")
}

model ShirtOrder {
  id             String           @id @default(cuid())
  registrationId String?
  eventId        String
  orderType      ShirtOrderType   @default(WITH_BIB)
  totalAmount    Int
  paymentStatus  PaymentStatus    @default(PENDING)
  paymentDate    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  email          String?
  payments       Payment[]
  items          ShirtOrderItem[]
  event          Event            @relation(fields: [eventId], references: [id])
  registration   Registration?    @relation(fields: [registrationId], references: [id])
  // ✅ NEW FIELDS:
  fullName       String? // Tên người mua
  phone          String? // SĐT liên hệ  
  address        String? // Địa chỉ giao hàng
  city           String? // Tỉnh/TP
  notes          String? // Ghi chú

  @@index([email])
  @@index([phone])
  @@index([fullName])
  @@index([eventId, paymentStatus])
  @@index([registrationId])
  @@map("shirt_orders")
}

model ShirtOrderItem {
  id         String     @id @default(cuid())
  orderId    String
  shirtId    String
  quantity   Int        @default(1)
  unitPrice  Int
  totalPrice Int
  createdAt  DateTime   @default(now())
  order      ShirtOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shirt      EventShirt @relation(fields: [shirtId], references: [id])

  @@index([orderId])
  @@index([shirtId])
  @@map("shirt_order_items")
}

model MerchCampaign {
  id                          String              @id @default(cuid())
  name                        String
  slug                        String              @unique
  description                 String?             @db.Text
  buyerNote                   String?             @db.Text
  year                        Int
  status                      MerchCampaignStatus @default(DRAFT)
  isPublished                 Boolean             @default(false)
  requireOnlinePayment        Boolean             @default(true)
  bankName                    String?             @db.Text
  bankAccount                 String?             @db.Text
  bankHolder                  String?             @db.Text
  bankCode                    String?             @db.Text
  heroImageUrl                String?
  cloudinaryPublicId          String?
  sizeGuideImageUrl           String?
  sizeGuideCloudinaryPublicId String?
  saleStartAt                 DateTime?
  saleEndAt                   DateTime?
  contactEmail                String?
  contactPhone                String?
  createdById                 String
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  createdBy                   User                @relation(fields: [createdById], references: [id])
  styles                      MerchShirtStyle[]
  orders                      MerchOrder[]

  @@index([status, isPublished])
  @@index([year])
  @@map("merch_campaigns")
}

model MerchShirtStyle {
  id                     String              @id @default(cuid())
  campaignId             String
  name                   String
  category               ShirtCategory
  type                   ShirtType
  price                  Int
  previewImageUrl        String?
  cloudinaryPublicId     String?
  backImageUrl           String?
  backCloudinaryPublicId String?
  isAvailable            Boolean             @default(true)
  sortOrder              Int                 @default(0)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  campaign               MerchCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variants               MerchShirtVariant[]
  orderItems             MerchOrderItem[]

  @@unique([campaignId, name, category, type])
  @@index([campaignId, isAvailable])
  @@map("merch_shirt_styles")
}

model MerchShirtVariant {
  id               String           @id @default(cuid())
  styleId          String
  size             ShirtSize
  stockQuantity    Int
  reservedQuantity Int              @default(0)
  soldQuantity     Int              @default(0)
  isAvailable      Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  style            MerchShirtStyle  @relation(fields: [styleId], references: [id], onDelete: Cascade)
  orderItems       MerchOrderItem[]

  @@unique([styleId, size])
  @@index([styleId, isAvailable])
  @@map("merch_shirt_variants")
}

model MerchOrder {
  id                String                 @id @default(cuid())
  campaignId        String
  publicCode        String                 @unique
  secretCodeHash    String
  fullName          String
  email             String
  phone             String
  shippingAddress   String                 @db.Text
  deliveryMethod    MerchDeliveryMethod    @default(DIRECT)
  notes             String?                @db.Text
  totalAmount       Int
  paymentStatus     PaymentStatus          @default(PENDING)
  fulfillmentStatus MerchFulfillmentStatus @default(PENDING)
  paymentDate       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  campaign          MerchCampaign          @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  items             MerchOrderItem[]
  payments          Payment[]

  @@index([campaignId, paymentStatus])
  @@index([email])
  @@index([phone])
  @@index([fullName])
  @@map("merch_orders")
}

model MerchOrderItem {
  id         String            @id @default(cuid())
  orderId    String
  styleId    String
  variantId  String
  styleName  String
  category   ShirtCategory
  type       ShirtType
  size       ShirtSize
  quantity   Int
  unitPrice  Int
  totalPrice Int
  createdAt  DateTime          @default(now())
  order      MerchOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  style      MerchShirtStyle   @relation(fields: [styleId], references: [id])
  variant    MerchShirtVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([styleId, variantId])
  @@map("merch_order_items")
}

model KidRunCampaign {
  id                        String                    @id @default(cuid())
  name                      String
  slug                      String                    @unique
  description               String?                   @db.Text
  eventDate                 DateTime
  location                  String
  status                    KidRunCampaignStatus      @default(DRAFT)
  isPublished               Boolean                   @default(false)
  allowRegistration         Boolean                   @default(false)
  requireOnlinePayment      Boolean                   @default(true)
  bankName                  String?                   @db.Text
  bankAccount               String?                   @db.Text
  bankHolder                String?                   @db.Text
  bankCode                  String?                   @db.Text
  heroImageUrl              String?
  heroCloudinaryPublicId    String?
  bibPickupNote             String?                   @db.Text
  shirtBuyerNote            String?                   @db.Text
  contactEmail              String?
  contactPhone              String?
  maxChildrenPerApplication Int                       @default(5)
  bibCapacity               Int                       @default(150)
  remainingBibCount         Int                       @default(150)
  createdById               String
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  createdBy                 User                      @relation(fields: [createdById], references: [id])
  images                    KidRunCampaignImage[]
  categories                KidRunRaceCategory[]
  waivers                   KidRunWaiver[]
  applications              KidRunFamilyApplication[]
  shirtStyles               KidRunShirtStyle[]
  webhookLogs               KidRunWebhookLog[]
  users                     KidRunCampaignUser[]

  @@index([status, isPublished])
  @@map("kid_run_campaigns")
}

model KidRunCampaignImage {
  id                 String         @id @default(cuid())
  campaignId         String
  imageUrl           String
  cloudinaryPublicId String?
  caption            String?
  sortOrder          Int            @default(0)
  createdAt          DateTime       @default(now())
  campaign           KidRunCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sortOrder])
  @@map("kid_run_campaign_images")
}

model KidRunRaceCategory {
  id                String              @id @default(cuid())
  campaignId        String
  name              String
  minBirthYear      Int
  maxBirthYear      Int
  distanceLabel     String
  bibPrefix         String
  bibStart          Int                 @default(1)
  nextBibNumber     Int                 @default(1)
  bibNumberDigits   Int                 @default(4)
  bibCapacity       Int                 @default(50)
  remainingBibCount Int                 @default(50)
  bibTemplateUrl    String?
  bibTextColor      String?
  bibNumberFontSize Int                 @default(245)
  bibNameFontSize   Int                 @default(42)
  isAvailable       Boolean             @default(true)
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  campaign          KidRunCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  participants      KidRunParticipant[]

  @@unique([campaignId, name])
  @@index([campaignId, bibPrefix])
  @@index([campaignId, isAvailable])
  @@map("kid_run_race_categories")
}

model KidRunWaiver {
  id           String                    @id @default(cuid())
  campaignId   String
  title        String
  content      String                    @db.Text
  version      String
  isActive     Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  campaign     KidRunCampaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  applications KidRunFamilyApplication[]

  @@unique([campaignId, version])
  @@index([campaignId, isActive])
  @@map("kid_run_waivers")
}

model KidRunFamilyApplication {
  id                 String                   @id @default(cuid())
  campaignId         String
  publicCode         String                   @unique
  secretCodeHash     String
  guardianName       String
  email              String
  phone              String
  notes              String?                  @db.Text
  status             KidRunRegistrationStatus @default(CONFIRMED)
  bibQrToken         String                   @unique
  waiverId           String
  waiverVersion      String
  waiverAcceptedAt   DateTime
  waiverAcceptedIp   String?
  waiverUserAgent    String?
  mediaConsent       Boolean                  @default(false)
  shirtTotalAmount   Int                      @default(0)
  shirtPaymentStatus KidRunPaymentStatus      @default(NOT_REQUIRED)
  shirtPaymentDate   DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  campaign           KidRunCampaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  waiver             KidRunWaiver             @relation(fields: [waiverId], references: [id], onDelete: Restrict)
  participants       KidRunParticipant[]
  shirts             KidRunParticipantShirt[]
  payments           KidRunPayment[]
  checkinLogs        KidRunCheckinLog[]
  emailLogs          KidRunEmailLog[]
  webhookLogs        KidRunWebhookLog[]

  @@index([campaignId, createdAt])
  @@index([campaignId, shirtPaymentStatus])
  @@index([email])
  @@index([phone])
  @@map("kid_run_family_applications")
}

model KidRunParticipant {
  id             String                   @id @default(cuid())
  applicationId  String
  categoryId     String
  fullName       String
  dateOfBirth    DateTime                 @db.Date
  birthYear      Int
  gender         KidRunGender
  schoolClub     String?
  bibNumber      String?
  bibCollectedAt DateTime?
  bibCollectedBy  String?
  bibStatus       KidRunBibStatus @default(ACTIVE)
  bibCancelledAt  DateTime?
  bibCancelledBy  String?
  bibCancelReason String?         @db.Text
  createdAt       DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  application    KidRunFamilyApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category       KidRunRaceCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shirts         KidRunParticipantShirt[]
  checkinLogs    KidRunCheckinLog[]

  @@unique([categoryId, bibNumber])
  @@index([applicationId])
  @@index([categoryId])
  @@index([categoryId, bibStatus])
  @@map("kid_run_participants")
}

model KidRunShirtStyle {
  id                      String                   @id @default(cuid())
  campaignId              String
  name                    String
  category                ShirtCategory
  type                    ShirtType
  price                   Int
  frontImageUrl           String?
  frontCloudinaryPublicId String?
  backImageUrl            String?
  backCloudinaryPublicId  String?
  sizeGuideImageUrl       String?
  isAvailable             Boolean                  @default(true)
  sortOrder               Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  campaign                KidRunCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variants                KidRunShirtVariant[]
  participantShirts       KidRunParticipantShirt[]

  @@unique([campaignId, name, category, type])
