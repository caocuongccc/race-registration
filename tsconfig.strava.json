{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "paths": {
      "@/*": ["./*"],
      "@/lib/event-permissions": ["./tests/type-stubs/event-permissions.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "lib/challenge-rules/**/*.ts",
    "lib/challenge-jobs/**/*.ts",
    "lib/challenges/**/*.ts",
    "lib/strava/**/*.ts",
    "app/api/strava/**/*.ts",
    "app/api/challenges/**/*.ts",
    "app/challenges/**/*.tsx",
    "app/api/admin/challenges/**/*.ts",
    "app/admin/dashboard/challenges/**/*.tsx",
    "app/api/webhooks/strava/**/*.ts",
    "app/api/cron/challenge-jobs/**/*.ts",
    "scripts/test-challenge-rules.ts",
    "scripts/test-challenge-job-queue.ts",
    "scripts/test-strava-normalizer.ts",
    "scripts/test-strava-security.ts"
  ],
  "exclude": ["node_modules"]
}

